# MetaOS's GraphQL API (GraphQL.kt), at /graphql. Anyone may query what's public, like the released episodes; the
# rest needs a token from Keycloak with metaos:read, and changes (Mutation) one with metaos:write.

type Query {
    "The latest released (PUBLISHED) episodes, the most recently aired first; at most 20"
    releasedEpisodes(limit: Int! = 3): [Episode!]!

    """
    Episodes still to be recorded (IDEA, PLANNED, SCHEDULED) that have a session or a recording date, the soonest
    first. Needs a signed-in user.
    """
    upcomingRecordings: [Episode!]!

    "Recorded episodes that aren't public yet, the earliest recorded first. Needs a signed-in user."
    inProduction: [Episode!]!

    """
    Every episode but the ideas, which ideas has, the latest season and episode first and those without a code last.
    Anyone not signed in gets only the released (PUBLISHED) ones.
    """
    episodes: [Episode!]!

    "The episode ideas (IDEA), the most recently added first. Needs a signed-in user."
    ideas: [Episode!]!

    """
    An episode by its code (e.g. S05E08) or ID; null if there's none. Anyone not signed in gets only a released
    (PUBLISHED) one, and null for any other.
    """
    episode(ref: String!): Episode

    "A recording session by its ID; null if there's none. Needs a signed-in user."
    session(id: ID!): Session

    """
    A person by their ID; null if there's none. Anyone not signed in gets only someone on the released (PUBLISHED)
    episodes, as anything but a candidate, as people lists them, and null for anyone else.
    """
    person(id: ID!): Person

    """
    Episodes (ideas too), people and recording sessions that match the text, the best first, at most limit of each (up
    to 100). An episode code, however it's typed (S05E08, s5e8, 5x08), or an episode's ID finds that episode on its own,
    and a season (S04) its episodes. Case and diacritics don't matter, and the start of a word is enough. Needs a
    signed-in user.
    """
    search(text: String!, limit: Int! = 10): SearchResults!

    """
    The latest changes to episodes, sessions and people, and to what's linked to them (people's roles, docs, folders,
    comments, sign-ins), oldest first, as their histories tell them, each with what it's a change to: at most limit,
    up to 200. Needs a signed-in user.
    """
    recentChanges(limit: Int! = 50): [Change!]!

    """
    Everyone, by name, with who they are and where they're online. Anyone not signed in gets only those on the released
    (PUBLISHED) episodes, as anything but a candidate.
    """
    people: [Person!]!

    "The signed-in user, from the bearer token; null without one"
    me: CurrentUser

    """
    The Keycloak users MetaOS has seen, the newest first: all of them, or only those not linked to a person yet. Needs a
    signed-in user.
    """
    accounts(unlinked: Boolean! = false): [Account!]!

    "One of an episode's video or audio files by its ID, e.g. for a link to download it; null if there's none. Needs a signed-in user."
    mediaFile(id: ID!): MediaFile

    """
    Transcriptions of episodes' files, the latest first: those in statuses (all, without them), by provider (google
    or soniox) where it's given, at most limit, up to 500. Needs a signed-in user.
    """
    transcriptions(statuses: [TranscriptionStatus!], provider: String, limit: Int! = 100): [Transcription!]!

    "A transcription by its ID, as it is now, e.g. to watch it; null if there's none. Needs a signed-in user."
    transcription(id: ID!): Transcription

    "A transcript by its ID, with what was said; null if there's none. Needs a signed-in user."
    transcript(id: ID!): Transcript

    "The speech-to-text providers MetaOS has, to transcribe with. Needs a signed-in user."
    speechProviders: [SpeechProvider!]!

    "Which YouTube channel MetaOS is connected to, as its bot, and whether a look at it is on. Needs a signed-in user."
    youtube: YouTube!

    """
    The videos on Ogrodje's YouTube channel, as MetaOS knows them, the latest first, private and unlisted ones too:
    those with privacy, with every word of query in their title, description or tags, and, with unlinked, those that
    are no episode's; at most limit, up to 500. Needs a signed-in user.
    """
    youtubeVideos(privacy: YouTubePrivacy, query: String, unlinked: Boolean! = false, limit: Int! = 100): [YouTubeVideo!]!

    "Uploads of episodes' videos to YouTube, the latest first: those in statuses (all, without them). Needs a signed-in user."
    youtubeUploads(statuses: [YouTubeUploadStatus!], limit: Int! = 100): [YouTubeUpload!]!

    "An upload to YouTube by its ID, as it is now, e.g. to watch it; null if there's none. Needs a signed-in user."
    youtubeUpload(id: ID!): YouTubeUpload

    """
    Where episodes went out, of every episode, the latest first by when they went out: those on channel, where it's
    given, since a day or a time (e.g. 2026-11-01), at most limit, up to 500. Needs a signed-in user.
    """
    distributions(channel: Channel, since: String, limit: Int! = 100): [Distribution!]!

    """
    Ogrodje's supporters and partners as they're listed today, with their logos on the home page and in the footer:
    supporters (SUPPORTER) first, then partners, each by name
    """
    supporters: [Organisation!]!

    """
    Every organisation, by name: supporters and partners, the companies people work at, and those whose events are on
    the Events page; only those archived, or not, where archived is given. Needs a signed-in user.
    """
    organisations(archived: Boolean): [Organisation!]!

    "An organisation by its ID; null if there's none. Needs a signed-in user."
    organisation(id: ID!): Organisation

    """
    Slovenia's tech, developer and startup events, as the scrapers gather them from organisations' links (and the team
    adds), that haven't ended yet (or started, when they have no end), the soonest first; the hidden ones too, with
    hidden, for a signed-in user
    """
    events(hidden: Boolean): [Event!]!

    "An event by its ID, a past one too, for its page; null if there's none, or, without a signed-in user, it's hidden"
    event(id: ID!): Event

    "Whether a refresh of every organisation's events, or of organisation's, is on. Needs a signed-in user."
    eventsRefresh(organisation: ID): EventsRefresh!
    "How many organisations the Events page gathers events from: not archived, collecting them, with a link to read"
    eventOrganisers: Int!
}

"""
An event, by an organisation, as a scraper found it on the organisation's links, or the team added it (source MANUAL).
Its start and end are instants (ISO 8601, UTC), with a time of day only where hasStartTime and hasEndTime say; one
without an end has none.
"""
type Event {
    id: ID!
    title: String!
    description: String
    "Where it's announced, e.g. on Meetup or Eventbrite"
    url: String
    start: String!
    end: String
    hasStartTime: Boolean!
    hasEndTime: Boolean!
    "Where it is, as its source or the team says; see place"
    locationName: String
    locationAddress: String
    "Where it is: its own location, else its organisation's venue, where it doesn't say. Null where neither says."
    place: EventPlace
    """
    Where that is, for the Events page's filter: its own region, which its place tells or the team gave it, else its
    organisation's. Null where nothing says.
    """
    region: Region
    "Whether the team gave it its region, rather than its place or its organisation telling it"
    regionManual: Boolean!
    "Ogrodje's picks, which stand out"
    promoted: Boolean!
    "Hidden by the team: not listed for anyone else"
    hidden: Boolean!
    "Which scraper found it, e.g. MEETUP, or MANUAL for the team's own, which they may change wholly"
    source: String!
    "The page the scraper read it from. Null without a signed-in user."
    sourceUrl: String
    "Who it's by"
    organisation: Organisation!
    "Who it's by, as its badge: the organisation's name, logo and colours"
    meetup: Meetup!
    """
    Up to three of its organisation's other events that aren't hidden, for its page: those that haven't ended yet, the
    soonest first, then the past ones, the latest first
    """
    moreFromOrganiser: [Event!]!
}

"""
Where an event is, for the Events page's filter: one of Slovenia's 12 statistical regions, as they are since 2015,
online, or abroad
"""
enum Region {
    "Pomurska"
    POMURSKA
    "Podravska"
    PODRAVSKA
    "Koroška"
    KOROSKA
    "Savinjska"
    SAVINJSKA
    "Zasavska"
    ZASAVSKA
    "Posavska"
    POSAVSKA
    "Jugovzhodna Slovenija"
    JUGOVZHODNA
    "Osrednjeslovenska"
    OSREDNJESLOVENSKA
    "Gorenjska"
    GORENJSKA
    "Primorsko-notranjska"
    PRIMORSKO_NOTRANJSKA
    "Goriška"
    GORISKA
    "Obalno-kraška"
    OBALNO_KRASKA
    "Na spletu"
    ONLINE
    "Tujina"
    ABROAD
}

"Where an event is: its place, e.g. Kovačnica, and its address; either may be missing"
type EventPlace {
    name: String
    address: String
    "Whether it's the organisation's venue, as the event doesn't say"
    fromOrganisation: Boolean!
}

"Who an event is by, as its badge on the Events page"
type Meetup {
    name: String!
    logo: String
    "Its text's colour, e.g. #ffffff"
    mainColor: String
    backgroundColor: String
}

"How one of an organisation's links was last scraped"
type EventScrape {
    "WEBSITE, MEETUP, EVENTBRITE, ICAL, LUMA or KOMPOT: the field of the organisation the link is in"
    field: String!
    url: String!
    "The scraper that read it, e.g. MEETUP; null when none takes it, or it failed"
    source: String
    scrapedAt: String!
    "How many events it found"
    events: Int!
    "Why it failed, when it did"
    error: String
}

"Whether the team's refresh of events, of every organisation's or of one's, is on"
type EventsRefresh {
    running: Boolean!
    startedAt: String
}

type Mutation {
    "Comment on an episode (ideas too) by its code or ID, in Markdown"
    commentOnEpisode(ref: String!, body: String!): Comment!
    "Comment on a recording session, in Markdown"
    commentOnSession(id: ID!, body: String!): Comment!
    "Change the text of one of your comments"
    editComment(id: ID!, body: String!): Comment!
    "Delete one of your comments; the history keeps that it was there. Its ID."
    deleteComment(id: ID!): ID!
    "Link an account to the person it is. One linked to someone else has to be unlinked first. Only for canLinkAccounts."
    linkAccount(id: ID!, person: ID!): Account!
    "Unlink an account from its person. Only for canLinkAccounts."
    unlinkAccount(id: ID!): Account!
    """
    Create a recording session, as create_session does over MCP: its date, a day, e.g. 2026-10-22, and what it's called,
    where it is and its address. Empty text is none; without a name it goes by its location, else by its date.
    """
    createSession(date: String!, name: String, location: String, address: String): Session!
    """
    Change a recording session, as update_session does over MCP: what's left out stays as it is, and an empty name,
    location or address clears it. The date is a day, e.g. 2026-10-22.
    """
    updateSession(id: ID!, date: String, name: String, location: String, address: String): Session!
    """
    Start uploading a picture, PNG, JPEG, WebP or GIF of size bytes, up to 50 MB: it's sent straight to MetaOS's bucket,
    then setEpisodeImage, setPersonAvatar or setOrganisationLogo makes it theirs
    """
    imageUpload(contentType: String!, size: Int!): ImageUpload!
    "Start uploading a picture for an episode, PNG or JPEG, as imageUpload does"
    artworkUpload(ref: String!, contentType: String!, size: Int!): ImageUpload! @deprecated(reason: "Use imageUpload")
    """
    Make an upload, of a file called name, one of an episode's pictures, which it has to be the size of, and put it in
    the episode's first Dropbox folder too, unless it's there already. Another picture the episode has there already is
    only replaced with replace. The upload is gone afterwards, also when it's refused.
    """
    setEpisodeImage(ref: String!, kind: EpisodeImage!, upload: ID!, name: String!, replace: Boolean! = false): EpisodeImageSet!
    "Take one of an episode's pictures off it; the one it had"
    removeEpisodeImage(ref: String!, kind: EpisodeImage!): Image
    "Make an upload, of a file called name, of any size, the person's avatar. The upload is gone afterwards."
    setPersonAvatar(personId: ID!, upload: ID!, name: String!): Image!
    "Take the person's avatar off them; the one they had"
    removePersonAvatar(personId: ID!): Image
    "Make an upload, of a file called name, of any size, the organisation's logo. The upload is gone afterwards."
    setOrganisationLogo(organisationId: ID!, upload: ID!, name: String!): Image!
    "Take the organisation's logo off it; the one it had"
    removeOrganisationLogo(organisationId: ID!): Image
    """
    Start uploading a video or audio file for an episode, of size bytes, up to 50 GB: video (MP4 or MOV) for a video,
    audio (MP3, M4A, WAV or FLAC) for an audio. The browser sends it straight to MetaOS's bucket, then addEpisodeMedia
    makes it the episode's.
    """
    mediaUpload(ref: String!, kind: MediaKind!, contentType: String!, size: Float!): MediaUpload!
    """
    Make an upload, of a file called name, one of an episode's video or audio files, once ffprobe has read what's in it:
    a video has to have video, an audio audio and no video. A full video or full audio the episode has already is only
    replaced with replace; a file it has already isn't added again. A title says what a bonus is. The upload is gone
    afterwards, also when it's refused.
    """
    addEpisodeMedia(ref: String!, kind: MediaKind!, upload: ID!, name: String!, title: String, replace: Boolean! = false): MediaFile!
    """
    Change a video or audio file's title (an empty one clears it), or what it is: video stays video and audio audio,
    and it becomes the full video or full audio only while the episode has none. What's left out stays as it is.
    """
    updateEpisodeMedia(id: ID!, title: String, kind: MediaKind): MediaFile!
    "Take a video or audio file off its episode, and delete it from MetaOS's bucket; the history keeps it. Its ID."
    removeEpisodeMedia(id: ID!): ID!
    """
    Transcribe one of an episode's files by a provider, as transcribe_episode does over MCP: google (Speech-to-Text,
    in the EU, which doesn't punctuate Slovenian or tell speakers apart) or soniox (in the US, which does both), by
    default MetaOS's; its full audio, else its full video, unless media says which; in its show's language unless told
    another (e.g. en-GB). A file it has a transcript of by that provider only with replace. With Google, batch is
    within a day, for a fifth of the price. It waits for its turn at the provider, which hears a few at once.
    """
    transcribeEpisode(ref: String!, media: ID, provider: String, language: String, batch: Boolean! = false, replace: Boolean! = false): Transcription!
    "Cancel a transcription that's on: it stops, and asks the provider to stop too"
    cancelTranscription(id: ID!): Transcription!
    "Look at the YouTube channel now, in a workflow, rather than at the next hour"
    refreshYouTubeVideos: YouTube!
    """
    Send one of an episode's video files to Ogrodje's YouTube channel, in a workflow, always as a private video, which
    a person publishes in YouTube Studio: its full video, unless media says which; with a title (by default the
    episode's), a description (by default its summary), tags, and one of the episode's thumbnails (the full video gets
    its thumbnail by default; noThumbnail sends it without). A file MetaOS sent already goes again only with again.
    """
    uploadToYouTube(
        ref: String!, media: ID, title: String, description: String, tags: [String!], thumbnail: EpisodeImage,
        noThumbnail: Boolean! = false, again: Boolean! = false
    ): YouTubeUpload!
    "Cancel an upload to YouTube that's on. A video that's on YouTube by then stays there, private."
    cancelYouTubeUpload(id: ID!): YouTubeUpload!
    """
    Change what one of the channel's videos (by its ID, YouTube's, or its address) says about itself on YouTube: its
    title, description or tags, those left out staying as they are. Never who may see it.
    """
    updateYouTubeVideo(id: String!, title: String, description: String, tags: [String!]): YouTubeVideo!
    "Say which episode (by its code or ID) one of the channel's videos is, or, without one, that it's no episode's"
    setYouTubeVideoEpisode(id: String!, episode: String): YouTubeVideo!
    "Give one of the channel's videos one of an episode's thumbnails: its own episode's, unless episode says another's"
    setYouTubeVideoThumbnail(id: String!, picture: EpisodeImage! = THUMBNAIL, episode: String): YouTubeVideo!
    "Remove a transcript, and what it says; the bucket keeps its files, and the history that it was there. Its ID."
    removeTranscript(id: ID!): ID!
    """
    Name one of a transcript's speakers, by its label (1, or Speaker 1), as name_transcript_speaker does over MCP: as a
    person on its episode, or by a name for someone who isn't in MetaOS; with neither, its name is cleared.
    """
    nameTranscriptSpeaker(id: ID!, label: String!, person: ID, name: String): Transcript!
    """
    Set or clear one of an episode's links, by its code or ID: an https URL of the episode on that platform, or null
    to clear it. Each of the four Patreon links is set or cleared on its own.
    """
    setEpisodeLink(ref: String!, platform: Platform!, url: String): Episode!
    """
    Log where an episode went out, by its URL, as add_episode_distribution does over MCP: its channel by the URL's
    host, unless given; when it went out a day (2026-11-10) or a date and time. A URL the episode has already is that
    entry, with what's given changed. With link, the URL becomes that one of the episode's links. MetaOS fetches its
    preview once it's in.
    """
    addDistribution(ref: String!, url: String!, channel: Channel, postedAt: String, note: String, title: String, link: Platform): Distribution!
    """
    Change where an episode went out: what's left out stays as it is, and an empty note, title or postedAt clears it.
    One of the episode's links changes the link too.
    """
    updateDistribution(id: ID!, url: String, channel: Channel, postedAt: String, note: String, title: String): Distribution!
    "Take where an episode went out off it; one of its links is cleared on the episode too. Its ID."
    removeDistribution(id: ID!): ID!
    "Fetch the preview of where an episode went out again; it keeps the one it had until the new one is there"
    refreshDistributionPreview(id: ID!): Distribution!
    """
    Create an organisation, as create_organisation does over MCP, with what update_organisation sets; what's left out is
    none
    """
    createOrganisation(input: OrganisationInput!): Organisation!
    """
    Change an organisation, as update_organisation does over MCP: what's left out stays as it is, and empty text clears
    it. Days are days, e.g. 2026-11-16; contactPerson a person's ID.
    """
    updateOrganisation(id: ID!, input: OrganisationInput!): Organisation!
    "Soft-delete an organisation; restore_organisation brings it back over MCP. Its ID."
    deleteOrganisation(id: ID!): ID!
    """
    Say that a person works at an organisation, with their title and from when till when (days, e.g. 2026-11-16), as
    link_person_to_organisation does; not again while they work there without an end
    """
    addPersonToOrganisation(person: ID!, organisation: ID!, title: String, startedAt: String, endedAt: String): OrganisationPerson!
    "Change a person's work at an organisation: what's left out stays as it is, and empty text clears it"
    updatePersonOrganisation(id: ID!, title: String, startedAt: String, endedAt: String): OrganisationPerson!
    "Remove a person's work at an organisation, e.g. one added by mistake; the history keeps it. Its ID."
    removePersonFromOrganisation(id: ID!): ID!
    "Say that an organisation supported an episode's production, by the episode's code or ID; once"
    addEpisodeSupporter(ref: String!, organisation: ID!): Episode!
    "Take an organisation off the supporters of an episode"
    removeEpisodeSupporter(ref: String!, organisation: ID!): Episode!
    """
    Add an event of the team's own (MANUAL), by an organisation, with its title and start: a time (2026-11-16T18:00, in
    Ljubljana, or with its offset) or a day (2026-11-16), as its end
    """
    createEvent(input: EventInput!): Event!
    """
    Change an event: the team's own wholly; one a scraper found, only whether it's hidden or promoted. What's left out
    stays as it is, and empty text clears it.
    """
    updateEvent(id: ID!, input: EventInput!): Event!
    """
    Gather the events of every organisation that collects them again now, or of organisation's, unless that's on
    already; it goes on after the answer, and the events come as they're found
    """
    refreshEvents(organisation: ID): EventsRefresh!
}

"What an event is to be, for createEvent and updateEvent: what's left out stays as it is; empty text clears it"
input EventInput {
    "The ID of the organisation it's by"
    organisation: ID
    title: String
    "A time, e.g. 2026-11-16T18:00 (in Ljubljana) or 2026-11-16T17:00:00Z, or a day, e.g. 2026-11-16"
    start: String
    "As start; empty for none"
    end: String
    description: String
    "Where it's announced"
    url: String
    locationName: String
    locationAddress: String
    hidden: Boolean
    promoted: Boolean
    "Its region, a scraper's event's too, e.g. GORENJSKA; empty for the one its place tells, else its organisation's"
    region: String
}

"""
What an organisation is to be, for createOrganisation and updateOrganisation: what's left out is none, or stays as it
is; empty text clears it
"""
input OrganisationInput {
    name: String
    description: String
    tier: OrganisationTier
    "When it started supporting Ogrodje, a day, e.g. 2026-11-16"
    supportStartedAt: String
    "The last day it supported Ogrodje"
    supportEndedAt: String
    websiteUrl: String
    linkedinUrl: String
    twitterUrl: String
    instagramUrl: String
    facebookUrl: String
    vatId: String
    companyId: String
    address: String
    "The ID of the person to contact there"
    contactPerson: ID
    "Where it announces its events, read by the scrapers, as its website is"
    meetupUrl: String
    eventbriteUrl: String
    "A calendar (iCal: http, https or webcal)"
    icalUrl: String
    lumaUrl: String
    discordUrl: String
    kompotUrl: String
    "Its badge's text colour on the Events page, e.g. #ffffff"
    mainColor: String
    "Its badge's background, e.g. #000000"
    backgroundColor: String
    "Whether its events are gathered from its links"
    collectsEvents: Boolean
    "Archived: listed apart, and its events no longer gathered; nothing of it is deleted"
    archived: Boolean
    "Where its events usually are, e.g. Kovačnica, for those that don't say"
    venueName: String
    "That venue's address"
    venueAddress: String
    "Where its events usually are, e.g. GORENJSKA, for those with no region of their own; empty for the one its venue tells"
    region: String
}

"How an organisation supports Ogrodje, as ogrodje.si's footer had them, or not at all"
enum OrganisationTier {
    "Podporniki"
    SUPPORTER
    "Partnerji"
    PARTNER
    NONE
}

"""
An organisation: one of Ogrodje's supporters or partners, or a company people work at. What's the team's is null, or
empty, for anyone else.
"""
type Organisation {
    id: ID!
    name: String!
    "What it is, e.g. what it makes"
    description: String
    tier: OrganisationTier!
    "Whether it's listed as a supporter or partner today"
    supporting: Boolean!
    "When it started supporting Ogrodje, a day; null without a signed-in user"
    supportStartedAt: String
    "The last day it supported Ogrodje; null without a signed-in user"
    supportEndedAt: String
    websiteUrl: String
    linkedinUrl: String
    "On Twitter or X"
    twitterUrl: String
    instagramUrl: String
    facebookUrl: String
    "Its logo"
    logo: Image
    "Its VAT ID. Null without a signed-in user."
    vatId: String
    "Its company ID in its registry. Null without a signed-in user."
    companyId: String
    "Its registered address. Null without a signed-in user."
    address: String
    "Who to contact there. Null without a signed-in user."
    contactPerson: Person
    "Who works or worked there, those who still do first. None without a signed-in user."
    people: [OrganisationPerson!]!
    "The episodes it supported, the latest first. Anyone not signed in gets only the released ones."
    episodes: [Episode!]!
    "Where it announces its events, which the scrapers read, as its website"
    meetupUrl: String
    eventbriteUrl: String
    icalUrl: String
    lumaUrl: String
    discordUrl: String
    kompotUrl: String
    "Its badge's text colour on the Events page"
    mainColor: String
    "Its badge's background"
    backgroundColor: String
    "Whether its events are gathered from its links"
    collectsEvents: Boolean!
    "Archived: listed apart, and its events no longer gathered"
    archived: Boolean!
    "Where its events usually are, e.g. Kovačnica, which an event that doesn't say where it is goes by"
    venueName: String
    "That venue's address"
    venueAddress: String
    "Where its events usually are, which an event with no region of its own goes by: told from its venue, or the team's"
    region: Region
    "Whether the team gave it its region, rather than its venue telling it"
    regionManual: Boolean!
    "Its events, the latest first; anyone not signed in gets only the upcoming ones that aren't hidden, the soonest first"
    events: [Event!]!
    "How each of its links was last scraped. None without a signed-in user."
    eventScrapes: [EventScrape!]!
}

"Someone's work at an organisation: their title, and from when till when (days)"
type OrganisationPerson {
    id: ID!
    person: Person!
    organisation: Organisation!
    "e.g. CTO"
    title: String
    startedAt: String
    "Their last day there; null while they still work there"
    endedAt: String
    "Whether they still work there"
    current: Boolean!
}

"Where an episode went out, by its URL's host, else as someone said: its own links' platforms, and social networks"
enum Channel {
    YOUTUBE
    PATREON
    SPOTIFY
    APPLE_PODCASTS
    DISCORD
    LINKEDIN
    FACEBOOK
    INSTAGRAM
    REDDIT
    X
    BLUESKY
    MASTODON
    THREADS
    "monitor.si"
    MONITOR
    NEWSLETTER
    "Anything else, which goes by its page's site name"
    OTHER
}

"Whether a distribution has its preview: being fetched (or waiting to be), fetched, or not to be had, e.g. behind a login"
enum PreviewStatus {
    PENDING
    OK
    UNAVAILABLE
}

"""
Somewhere an episode went out: one of its own links (platform, as the episode has it), or a post that promotes it, e.g.
on Discord, LinkedIn or Reddit, with its page's preview
"""
type Distribution {
    id: ID!
    "Its episode; null once that's deleted"
    episode: Episode
    "The episode's link this is (youtubeUrl, ...); null for a post"
    platform: Platform
    channel: Channel!
    url: String!
    "What someone called it, e.g. as its page doesn't say; preview.title otherwise"
    title: String
    note: String
    "When it went out, as someone said; preview.publishedAt otherwise"
    postedAt: String
    "Who added it: their person's name, or else their username; for a link, whoever set it"
    addedBy: String
    createdAt: String!
    preview: DistributionPreview!
}

"What a distribution's page says about itself (OpenGraph), as MetaOS fetched it"
type DistributionPreview {
    status: PreviewStatus!
    title: String
    description: String
    "e.g. LinkedIn, or the page's host"
    site: String
    "When the page says it was published"
    publishedAt: String
    "Its picture, copied to MetaOS's public bucket"
    image: Image
    "Why there's none, e.g. a page that needs signing in"
    error: String
    fetchedAt: String
}

"Where an episode can be watched or listened to: one of its links"
enum Platform {
    "youtubeUrl"
    YOUTUBE
    "spotifyUrl"
    SPOTIFY
    "applePodcastsUrl"
    APPLE_PODCASTS
    "patreonUrl: the full episode, as video"
    PATREON
    "patreonAudioUrl: the full episode, as audio only"
    PATREON_AUDIO
    "patreonBonusUrl: its bonus, as video"
    PATREON_BONUS
    "patreonBonusAudioUrl: its bonus, as audio only"
    PATREON_BONUS_AUDIO
}

"An episode's pictures, each PNG or JPEG of exactly its size"
enum EpisodeImage {
    "1920 × 1080"
    THUMBNAIL
    "1920 × 1080, with titleB"
    THUMBNAIL_B
    "1920 × 1080, with titleC"
    THUMBNAIL_C
    "1920 × 1080: the thumbnail without its words, for ogrodje.si"
    WEB
    "3000 × 3000"
    COVER
}

"""
Where the browser sends a picture: a resumable upload, started with a POST to url with exactly these headers and no
body, after which the file is PUT to the Location that answers. It only starts until expires.
"""
type ImageUpload {
    "What setEpisodeImage, setPersonAvatar and setOrganisationLogo take"
    id: ID!
    url: String!
    headers: [Header!]!
    expires: String!
}

type Header {
    name: String!
    value: String!
}

"What an episode's video and audio files are, as Patreon has them: one full video and one full audio, any number of bonuses"
enum MediaKind {
    FULL_VIDEO
    FULL_AUDIO
    BONUS_VIDEO
    BONUS_AUDIO
}

"Where the browser sends a video or audio file: a resumable upload, as ImageUpload says"
type MediaUpload {
    "What addEpisodeMedia takes"
    id: ID!
    url: String!
    headers: [Header!]!
    expires: String!
}

"Who may see a YouTube video. MetaOS uploads only private ones, which a person publishes."
enum YouTubePrivacy {
    PUBLIC
    UNLISTED
    PRIVATE
}

"How far an upload to YouTube is: waiting for its turn, being sent, YouTube processing it; then done, failed or cancelled"
enum YouTubeUploadStatus {
    QUEUED
    UPLOADING
    PROCESSING
    DONE
    FAILED
    CANCELLED
}

"The YouTube channel MetaOS is connected to, as Ogrodje's bot account"
type YouTube {
    "Whether MetaOS has the bot's token for the channel, and YouTube takes it"
    connected: Boolean!
    channelId: String
    "The channel's name, and its handle, e.g. @ogrodje"
    channel: String
    handle: String
    "Whether a look at the channel that someone asked for is on, and since when"
    refreshing: Boolean!
    refreshStartedAt: String
    "Why the channel couldn't be asked, when it couldn't"
    error: String
}

"One of the videos on Ogrodje's YouTube channel, as YouTube said it was when MetaOS last looked"
type YouTubeVideo {
    id: ID!
    "YouTube's ID of it, where it's watched (by those who may), and its page in YouTube Studio, where it's published"
    videoId: String!
    url: String!
    studioUrl: String!
    title: String!
    description: String!
    tags: [String!]!
    privacy: YouTubePrivacy!
    "YouTube's: uploaded (and being processed), processed, failed, rejected or deleted"
    uploadStatus: String
    "When a private one is scheduled to go public"
    publishAt: String
    "When it was uploaded, or went public"
    publishedAt: String
    "Seconds; none until YouTube has processed it"
    duration: Int
    "A stream, or the recording of one"
    live: Boolean!
    thumbnailUrl: String
    "Whose it is in MetaOS, if anyone's"
    episode: Episode
    "The episode's file MetaOS uploaded it from, if it did"
    mediaId: ID
    "When it was found to be off the channel"
    goneAt: String
}

"One of an episode's video files being sent to YouTube, as a private video"
type YouTubeUpload {
    id: ID!
    "Its episode; null once that's deleted"
    episode: Episode
    mediaId: ID!
    "The file's name, e.g. S05E08.mp4"
    mediaName: String!
    title: String!
    description: String!
    tags: [String!]!
    "Which of the episode's pictures it gets as its thumbnail, if any"
    thumbnail: EpisodeImage
    status: YouTubeUploadStatus!
    "While it's QUEUED, its place in line, 1 next"
    queued: Int
    "While it's UPLOADING, how much of the file is sent, by tens"
    percent: Int
    "Why it failed"
    error: String
    "What didn't go with it, e.g. its thumbnail, while the video did"
    note: String
    "YouTube's ID of the video, once the file is there, and the video as MetaOS knows it"
    videoId: String
    video: YouTubeVideo
    "Who asked for it: their person's name, or else their username"
    requestedBy: String
    createdAt: String!
    "When it started being sent"
    startedAt: String
    finishedAt: String
}

"""
How far a transcription is: waiting for its turn at its provider, starting it, the provider hearing it; then done,
failed or cancelled
"""
enum TranscriptionStatus {
    QUEUED
    STARTING
    RECOGNIZING
    DONE
    FAILED
    CANCELLED
}

"One of an episode's files to be transcribed by a provider, from when it's asked for till it's done, failed or cancelled"
type Transcription {
    id: ID!
    "Its episode; null once that's deleted"
    episode: Episode
    mediaId: ID!
    "The file's name, e.g. S05E08.mp3"
    mediaName: String!
    "Who hears it: google or soniox"
    provider: String!
    "The provider's model, once it's started"
    model: String
    "What's said in the file, BCP-47, e.g. sl-SI"
    language: String!
    batch: Boolean!
    status: TranscriptionStatus!
    "While it's QUEUED, its place in line, 1 next"
    queued: Int
    "While it's RECOGNIZING, how far the provider got, by tens, where it says (Google)"
    percent: Int
    "Why it failed"
    error: String
    "The transcript it made, while it's there"
    transcript: Transcript
    "Who asked for it: their person's name, or else their username"
    requestedBy: String
    createdAt: String!
    "When the provider started on it"
    startedAt: String
    finishedAt: String
}

"A transcript of one of an episode's files, in a language, by a provider"
type Transcript {
    id: ID!
    "Its episode; null once that's deleted"
    episode: Episode
    mediaId: ID!
    mediaName: String!
    "What the text is in, and what's said in the file, BCP-47: the same, but for a translation"
    language: String!
    spokenLanguage: String!
    provider: String!
    model: String!
    "Seconds of audio, as the provider billed them"
    duration: Float
    "How many stretches of what was said, and words"
    segments: Int!
    words: Int!
    "Its speakers, where the provider tells them apart (Soniox), by their labels, and names once they're named"
    speakers: [TranscriptSpeaker!]!
    requestedBy: String
    createdAt: String!
    "What was said, a stretch at a time, each from where it starts"
    lines: [TranscriptLine!]!
}

"One of a transcript's speakers: the provider's label (1, 2, ...), and who it is, once they're named"
type TranscriptSpeaker {
    label: String!
    "Their name: the person's, as it is now, or one written for someone who isn't in MetaOS"
    name: String
    "The person it is, by ID, where they're named as one"
    personId: ID
    "The person it is, where they're named as one; null for a written name, or one deleted since"
    person: Person
}

"A stretch of what was said, from start to end, in seconds from the start of the file"
type TranscriptLine {
    speaker: String
    start: Float!
    end: Float!
    text: String!
}

"A speech-to-text provider: its name, model, and how many files it hears at once"
type SpeechProvider {
    name: String!
    model: String!
    slots: Int!
}

"One of an episode's video or audio files, in MetaOS's private bucket"
type MediaFile {
    id: ID!
    kind: MediaKind!
    "What a bonus is about"
    title: String
    "The file's name, as it was uploaded"
    name: String!
    contentType: String!
    "Bytes"
    size: Float!
    "The file's MD5, in hex: the same file has the same one"
    md5: String
    crc32c: String
    "Their person's name, or else their username"
    uploadedBy: String!
    uploadedAt: String!
    "What's in it, as ffprobe read it"
    info: MediaInfo!
    "A link that downloads it for an hour, signed as it's asked for; null when MetaOS has no bucket"
    downloadUrl: String
}

"What's in a video or audio file, as ffprobe read it; null for what the file doesn't say"
type MediaInfo {
    "Seconds"
    duration: Float
    "Bits a second, of the whole file"
    bitrate: Float
    "e.g. MP4, MOV, MP3, WAV"
    container: String
    "ffprobe's names, e.g. h264, hevc, prores; null without video"
    videoCodec: String
    videoProfile: String
    width: Int
    height: Int
    frameRate: Float
    bitDepth: Int
    "e.g. bt709, or HDR (PQ)"
    color: String
    "e.g. aac, mp3, pcm_s24le, of the first audio track; null without audio"
    audioCodec: String
    sampleRate: Int
    channels: Int
    audioBitrate: Float
    audioTracks: Int!
    "When the file says it was made"
    madeAt: String
    "What made it, as the file says"
    encoder: String
}

"One of an episode's pictures, as an upload made it"
type EpisodeImageSet {
    kind: EpisodeImage!
    image: Image!
    "Where it is in the episode's first Dropbox folder; null when the episode has none"
    dropbox: DropboxCopy
}

type DropboxCopy {
    "Where it is in the folder's place; null when it isn't there"
    path: String
    "Whether MetaOS put it there; false when it was there already"
    copied: Boolean!
    "Why it isn't there"
    error: String
}

type Episode {
    id: ID!
    "e.g. S05E08"
    code: String
    title: String!
    "An alternative title, which the title is A/B tested against. Null without a signed-in user."
    titleB: String
    "Another alternative title, as titleB"
    titleC: String
    "The show it's part of"
    show: String
    "Its show's colour, as hex RGB, e.g. #0404a4"
    showColor: String
    "What it's spoken in, BCP-47: its show's language (en-GB for Borderless), else Slovenian, sl-SI; what it's transcribed as"
    language: String!
    status: EpisodeStatus!
    "The recording session it's part of"
    session: Session
    "Who recommended it: by default the person of whoever added it. Null without a signed-in user."
    recommendedBy: Person
    "When it is or was recorded, e.g. 2026-10-19"
    recordingDate: String
    "When it was released, e.g. 2026-10-19"
    airedDate: String
    "Description of the episode, in Markdown"
    summary: String
    "Very short summary of the episode, e.g. a sentence, in Markdown"
    tinySummary: String
    youtubeUrl: String
    spotifyUrl: String
    applePodcastsUrl: String
    "The full episode on Patreon, as video (PATREON)"
    patreonUrl: String
    "The full episode on Patreon, as audio only (PATREON_AUDIO)"
    patreonAudioUrl: String
    "Its bonus on Patreon, as video (PATREON_BONUS)"
    patreonBonusUrl: String
    "Its bonus on Patreon, as audio only (PATREON_BONUS_AUDIO)"
    patreonBonusAudioUrl: String
    """
    The people on the episode, each once with all of their roles; hosts first, candidates last. Candidates only for a
    signed-in user.
    """
    people: [EpisodePerson!]!
    "Google Docs about the episode, e.g. its preparation doc, the first linked first. None without a signed-in user."
    documents: [Document!]!
    "When it was added to MetaOS, e.g. 2026-10-19"
    addedDate: String!
    "AI-generated summary of the episode, in Markdown. Null without a signed-in user."
    machineSummary: String
    "Koofr folders about the episode, e.g. its recordings. None without a signed-in user."
    koofrFolders: [KoofrFolder!]!
    "Dropbox folders about the episode, e.g. its artwork, by path. None without a signed-in user."
    dropboxFolders: [DropboxFolder!]!
    "Every change to the episode, to what's linked to it and to its discussion, oldest first. None without a signed-in user."
    history: [Change!]!
    "Its discussion, oldest first. None without a signed-in user."
    comments: [Comment!]!
    "Its thumbnail, 1920 × 1080"
    thumbnail: Image
    "The thumbnail that goes with titleB, as they're A/B tested together. Null without a signed-in user."
    thumbnailB: Image
    "The thumbnail that goes with titleC, as thumbnailB"
    thumbnailC: Image
    "Its web picture: the thumbnail without its words, for ogrodje.si, 1920 × 1080"
    web: Image
    "Its cover, e.g. for podcast apps, 3000 × 3000"
    cover: Image
    "Its video and audio: the full episode and its bonuses, the first uploaded first. None without a signed-in user."
    media: [MediaFile!]!
    "Its files' transcripts, the latest first, without what they say (Transcript.lines). None without a signed-in user."
    transcripts: [Transcript!]!
    """
    Its videos on Ogrodje's YouTube channel, the latest first, private ones too: the one its YouTube link is, its posts
    there, and those MetaOS uploaded from its files. None without a signed-in user.
    """
    youtubeVideos: [YouTubeVideo!]!
    "The uploads of its files to YouTube, the latest first. None without a signed-in user."
    youtubeUploads: [YouTubeUpload!]!
    """
    Where it went out: its links, in Platform's order, then the posts that promote it, the latest first. None without a
    signed-in user.
    """
    distributions: [Distribution!]!
    "The organisations that supported its production, by name"
    supportedBy: [Organisation!]!
}

"""
A picture MetaOS serves to everyone from its public bucket, at https://media.ogrodje.si in production: the original,
and smaller copies of it for lists and pages. What a URL shows never changes, so browsers may keep it for good.
"""
type Image {
    "The file it was made from, e.g. ogrodje-vresGams-thumb1.png"
    name: String!
    "The original"
    url: String!
    width: Int!
    height: Int!
    "Copies of it, 320, 640, 1280 and 1920 px wide where it's wider than that, the narrowest first"
    sizes: [ImageSize!]!
    "The original's SHA-256, in hex: the same file is the same picture"
    sha256: String!
}

type ImageSize {
    width: Int!
    url: String!
}

"A folder in Koofr that's shared with Ogrodje's bot: a place (a shared folder), named when Koofr answers, and a path in it"
type KoofrFolder {
    place: String!
    placeName: String
    path: String!
    "The folder in Koofr's web app, for anyone the place is shared with"
    url: String!
    """
    The photos in the folder by name: those right in it, then those in the folders right in it; all of them, or the
    first limit. None without a signed-in user, or when Koofr doesn't answer.
    """
    photos(limit: Int): [KoofrPhoto!]!
}

"""
A folder in Dropbox, in a place (a folder shared with Ogrodje's bot): where it is now, as it's linked by its Dropbox ID,
which stays with it when it's moved or renamed; where it was linked when Dropbox doesn't answer
"""
type DropboxFolder {
    place: String!
    "Named when Dropbox answers"
    placeName: String
    path: String!
    "Gone from its place: deleted, or moved out of it"
    missing: Boolean!
    """
    A link to the folder that only those with access to it can open, wherever they have it in their Dropbox; or, while
    there's none, its path in Dropbox's web app, for those who have the place where the bot has it
    """
    url: String!
    """
    The pictures in the folder by name, e.g. an episode's artwork: those right in it, then those in the folders right in
    it; all of them, or the first limit. None without a signed-in user, when it's missing, or when Dropbox doesn't answer.
    """
    pictures(limit: Int): [DropboxPicture!]!
}

"A picture in a Dropbox folder: jpg, png, gif, webp, tiff or bmp"
type DropboxPicture {
    name: String!
    path: String!
    "MetaOS's path to a thumbnail, at most 640 × 480; it needs the bearer token, as the rest of the API does"
    thumbnail: String!
    "The linked folder it's in, as the folder's url opens it"
    url: String!
}

"A photo in a Koofr folder"
type KoofrPhoto {
    name: String!
    path: String!
    "MetaOS's path to a thumbnail, 512 px wide; it needs the bearer token, as the rest of the API does"
    thumbnail: String!
    "The folder it's in, in Koofr's web app"
    url: String!
}

"A change from the audit log, told as what happened"
type Change {
    "When, e.g. 2026-10-19T21:30:12.345+02:00"
    at: String!
    "Who made it, when they were signed in: their person's name, or else their username"
    actor: String
    "The OAuth client it came through, e.g. an MCP client's ID"
    client: String
    "The MCP tool that made it"
    tool: String
    "What it's a change to, e.g. the episode itself, or someone's role on it"
    kind: ChangeKind!
    "The comment it's a change to, when it's one to a comment"
    commentId: ID
    "What happened, e.g. Added Jure Čuhalev as host"
    summary: String!
    "The fields that changed, by their names"
    fields: [FieldChange!]!
    "What it's a change to, in recentChanges; null in an episode's or session's own history, which is about it"
    about: ChangeSubject
}

"The episode, session, person or organisation a change is to"
type ChangeSubject {
    kind: ChangeKind!
    id: ID!
    "An episode's title, a session's date and name (or else place), a person's or organisation's name"
    name: String!
    "An episode's code, once it has one"
    code: String
}

"One field of a change. From and to are null when there's nothing short to show, e.g. for a summary."
type FieldChange {
    field: String!
    from: String
    to: String
}

"A Google Doc in Ogrodje's Drive folder"
type Document {
    fileId: ID!
    url: String!
}

"Where and when several episodes get recorded, e.g. at a conference"
type Session {
    id: ID!
    "e.g. 2026-10-22"
    date: String!
    "What it's called, e.g. AWS Community Day Adria 2026. Without one it goes by its location, else by its date."
    name: String
    "Where it is, e.g. the venue"
    location: String
    "Google Docs about the session, e.g. its recording day plan, the first linked first. None without a signed-in user."
    documents: [Document!]!
    "Street address of the location. Null without a signed-in user."
    address: String
    "Its episodes, by code. None without a signed-in user."
    episodes: [Episode!]!
    "Koofr folders about the session, e.g. everything recorded that day. None without a signed-in user."
    koofrFolders: [KoofrFolder!]!
    "Dropbox folders about the session, by path. None without a signed-in user."
    dropboxFolders: [DropboxFolder!]!
    "Every change to the session, to what's linked to it, to which episodes are in it and to its discussion, oldest first. None without a signed-in user."
    history: [Change!]!
    "Its discussion, oldest first. None without a signed-in user."
    comments: [Comment!]!
}

"A comment in an episode's or a recording session's discussion, as on GitHub"
type Comment {
    id: ID!
    "Markdown"
    body: String!
    author: CommentAuthor!
    "When it was written, e.g. 2026-10-19T21:30:12.345+02:00"
    createdAt: String!
    "When its text last changed; null if it never did"
    editedAt: String
    "The MCP tool it was written with, e.g. comment_on_episode; null for MetaOS's own pages"
    tool: String
    "Whether the signed-in user wrote it, and so may edit and delete it"
    mine: Boolean!
}

"Who wrote a comment"
type CommentAuthor {
    "Their person's name, or else their username"
    name: String!
    username: String
    "The person linked to them by verified email when they wrote it; null if there was none, or they've been deleted since"
    person: Person
}

"Where an episode is in its lifecycle"
enum EpisodeStatus {
    IDEA
    PLANNED
    SCHEDULED
    RECORDED
    IN_PRODUCTION
    READY
    EARLY_ACCESS
    PUBLISHED
    ON_HOLD
    CANCELLED
}

type EpisodePerson {
    personId: ID!
    name: String!
    roles: [Role!]!
    "Their picture, as their avatar"
    avatar: Image
}

enum Role {
    HOST
    CO_HOST
    GUEST
    PRODUCER
    CONSULTANT
    DESIGNER
    "Could be the episode's guest, e.g. an idea's, until they're confirmed as one"
    CANDIDATE
}

type CurrentUser {
    username: String
    email: String
    emailVerified: Boolean!
    "The person the user is: their account's, or else the one with their verified email"
    person: Person
    "Their account, once MetaOS has seen it"
    account: Account
    "Whether they may link accounts to people and unlink them, which only one user may"
    canLinkAccounts: Boolean!
    "Whether they're a member: signed in, with an email Keycloak verified. Staff are members too"
    member: Boolean!
    "Whether they're staff, who use MetaOS: the team's data, changes and MCP"
    staff: Boolean!
}

"""
A Keycloak user MetaOS has seen, which may sign in with several identity providers (Google, Discord, ...), and the
person it is. Its details are as the token said them when they last changed.
"""
type Account {
    id: ID!
    "Keycloak's username, e.g. the email for a Google sign-in"
    username: String
    name: String
    email: String
    emailVerified: Boolean!
    person: Person
    "How it was linked to its person: by its verified email, or by someone"
    linkedHow: AccountLink
    "When, e.g. 2026-10-19T21:30:12.345+02:00"
    linkedAt: String
    "Who linked it, by name; null when its email did"
    linkedBy: String
    "When MetaOS first saw it"
    createdAt: String!
}

"What a change in the history is to"
enum ChangeKind {
    "The episode itself, or an episode moving in or out of the session"
    EPISODE
    "The session itself"
    SESSION
    "Someone added to the episode, removed from it, or given another role on it; or a person themselves"
    PERSON
    "A Google Doc linked or unlinked"
    DOCUMENT
    KOOFR_FOLDER
    DROPBOX_FOLDER
    "A comment written, edited or deleted"
    COMMENT
    "A sign-in linked to a person or unlinked"
    ACCOUNT
    "A video or audio file uploaded, changed or removed"
    MEDIA
    "Where it went out: a post logged, changed or removed (its links are EPISODE's)"
    DISTRIBUTION
    "An organisation itself, someone's work there, or its support of an episode"
    ORGANISATION
    "One of an organisation's events, as the team changed it: added, hidden, picked or edited"
    EVENT
    OTHER
}

enum AccountLink {
    EMAIL
    MANUAL
}

"Someone on Ogrodje's episodes, e.g. a host or a guest"
type Person {
    id: ID!
    name: String!
    "A line about who they are, e.g. their role and company"
    bio: String
    "Their own website"
    homepageUrl: String
    linkedinUrl: String
    "On Twitter or X"
    twitterUrl: String
    instagramUrl: String
    facebookUrl: String
    """
    The episodes they're on, each once with all of their roles, the latest first. Anyone not signed in gets only the
    released ones, without candidates.
    """
    episodes: [PersonEpisode!]!
    "The episodes they recommended, the latest first. None without a signed-in user."
    recommended: [Episode!]!
    "Their picture"
    avatar: Image
    "The accounts they sign in with. None without a signed-in user."
    accounts: [Account!]!
    "Where they work or worked, where they still do first. None without a signed-in user."
    organisations: [OrganisationPerson!]!
}

"An episode a person is on, with their roles in it"
type PersonEpisode {
    episode: Episode!
    roles: [Role!]!
}

"""
What a search found: the episode whose code or ID the text is, alone; a season's episodes; or the best matches of each
kind, and how many there are in all
"""
type SearchResults {
    episode: Episode
    "The season the text names, e.g. 4 for S04, whose episodes the episodes are"
    season: Int
    episodes: [EpisodeHit!]!
    people: [PersonHit!]!
    sessions: [SessionHit!]!
    "Organisations, archived ones too"
    organisations: [OrganisationHit!]!
    "Events that haven't ended, and those that ended in the last month, hidden ones too: the soonest first"
    events: [EventHit!]!
    "How many episodes match, also past the limit"
    episodeCount: Int!
    personCount: Int!
    sessionCount: Int!
    organisationCount: Int!
    eventCount: Int!
}

"An episode a search found"
type EpisodeHit {
    episode: Episode!
    "Where it matched, the best first"
    matchedIn: [SearchField!]!
    """
    The text it matched in when that's an alternative title or a summary, which its row wouldn't show otherwise: the
    title, or the part of the summary around the match, as plain text
    """
    snippet: String
}

"A person a search found"
type PersonHit {
    person: Person!
    matchedIn: [SearchField!]!
}

"A recording session a search found"
type SessionHit {
    session: Session!
    matchedIn: [SearchField!]!
}

"An organisation a search found"
type OrganisationHit {
    organisation: Organisation!
    matchedIn: [SearchField!]!
}

"An event a search found"
type EventHit {
    event: Event!
    matchedIn: [SearchField!]!
}

"""
Where a search matched: an episode's code, titles, people, show, summaries or session; a person's name or bio; a
session's name, place, address or date; an organisation's name, description or venue; an event's title, organisation,
place, address, date or description
"""
enum SearchField {
    CODE
    TITLE
    ALTERNATIVE_TITLE
    PEOPLE
    SHOW
    TINY_SUMMARY
    SUMMARY
    SESSION
    NAME
    BIO
    LOCATION
    ADDRESS
    DATE
    DESCRIPTION
    ORGANISATION
}
