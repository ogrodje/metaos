# MetaOS's GraphQL API (GraphQL.kt), at /graphql. Anyone may query what's public, like the released episodes; the
# rest needs a token from Keycloak with metaos:read, and changes (Mutation) one with metaos:write.

type Query {
    "The latest released (PUBLISHED) episodes, the most recently aired first; at most 20"
    releasedEpisodes(limit: Int! = 3): [Episode!]!

    """
    Episodes still to be recorded (IDEA, PLANNED, SCHEDULED) that have a session or a recording date, the soonest
    first. Needs a signed-in user.
    """
    upcomingRecordings: [Episode!]!

    "Recorded episodes that aren't public yet, the earliest recorded first. Needs a signed-in user."
    inProduction: [Episode!]!

    """
    Every episode but the ideas, which ideas has, the latest season and episode first and those without a code last.
    Anyone not signed in gets only the released (PUBLISHED) ones.
    """
    episodes: [Episode!]!

    "The episode ideas (IDEA), the most recently added first. Needs a signed-in user."
    ideas: [Episode!]!

    """
    An episode by its code (e.g. S05E08) or ID; null if there's none. Anyone not signed in gets only a released
    (PUBLISHED) one, and null for any other.
    """
    episode(ref: String!): Episode

    "A recording session by its ID; null if there's none. Needs a signed-in user."
    session(id: ID!): Session

    """
    A person by their ID; null if there's none. Anyone not signed in gets only someone on the released (PUBLISHED)
    episodes, as anything but a candidate, as people lists them, and null for anyone else.
    """
    person(id: ID!): Person

    """
    Episodes (ideas too), people and recording sessions that match the text, the best first, at most limit of each (up
    to 100). An episode code, however it's typed (S05E08, s5e8, 5x08), or an episode's ID finds that episode on its own,
    and a season (S04) its episodes. Case and diacritics don't matter, and the start of a word is enough. Needs a
    signed-in user.
    """
    search(text: String!, limit: Int! = 10): SearchResults!

    """
    The latest changes to episodes, sessions and people, and to what's linked to them (people's roles, docs, folders,
    comments, sign-ins), oldest first, as their histories tell them, each with what it's a change to: at most limit,
    up to 200. Needs a signed-in user.
    """
    recentChanges(limit: Int! = 50): [Change!]!

    """
    Everyone, by name, with who they are and where they're online. Anyone not signed in gets only those on the released
    (PUBLISHED) episodes, as anything but a candidate.
    """
    people: [Person!]!

    "The signed-in user, from the bearer token; null without one"
    me: CurrentUser

    """
    The Keycloak users MetaOS has seen, the newest first: all of them, or only those not linked to a person yet. Needs a
    signed-in user.
    """
    accounts(unlinked: Boolean! = false): [Account!]!
}

"""
Changes, as the signed-in user: each needs an approved user's token with metaos:write (CommentsGraphQL.kt, Artwork.kt,
GraphQL.kt, SessionsGraphQL.kt)
"""
type Mutation {
    "Comment on an episode (ideas too) by its code or ID, in Markdown"
    commentOnEpisode(ref: String!, body: String!): Comment!
    "Comment on a recording session, in Markdown"
    commentOnSession(id: ID!, body: String!): Comment!
    "Change the text of one of your comments"
    editComment(id: ID!, body: String!): Comment!
    "Delete one of your comments; the history keeps that it was there. Its ID."
    deleteComment(id: ID!): ID!
    "Link an account to the person it is. One linked to someone else has to be unlinked first. Only for canLinkAccounts."
    linkAccount(id: ID!, person: ID!): Account!
    "Unlink an account from its person. Only for canLinkAccounts."
    unlinkAccount(id: ID!): Account!
    """
    Change a recording session, as update_session does over MCP: what's left out stays as it is, and an empty name,
    location or address clears it. The date is a day, e.g. 2026-10-22.
    """
    updateSession(id: ID!, date: String, name: String, location: String, address: String): Session!
    """
    Start uploading a picture for an episode, PNG or JPEG of size bytes, up to 50 MB: the browser sends it straight to
    MetaOS's bucket, then setEpisodeImage makes it one of the episode's pictures
    """
    artworkUpload(ref: String!, contentType: String!, size: Int!): ArtworkUpload!
    """
    Make an upload, of a file called name, one of an episode's pictures, which it has to be the size of, and put it in
    the episode's first Dropbox folder too, unless it's there already. Another picture the episode has there already is
    only replaced with replace. The upload is gone afterwards, also when it's refused.
    """
    setEpisodeImage(ref: String!, kind: EpisodeImage!, upload: ID!, name: String!, replace: Boolean! = false): EpisodeImageSet!
    """
    Set or clear one of an episode's links, by its code or ID: an https URL of the episode on that platform, or null
    to clear it. Each of the four Patreon links is set or cleared on its own.
    """
    setEpisodeLink(ref: String!, platform: Platform!, url: String): Episode!
}

"Where an episode can be watched or listened to: one of its links"
enum Platform {
    "youtubeUrl"
    YOUTUBE
    "spotifyUrl"
    SPOTIFY
    "applePodcastsUrl"
    APPLE_PODCASTS
    "patreonUrl: the full episode, as video"
    PATREON
    "patreonAudioUrl: the full episode, as audio only"
    PATREON_AUDIO
    "patreonBonusUrl: its bonus, as video"
    PATREON_BONUS
    "patreonBonusAudioUrl: its bonus, as audio only"
    PATREON_BONUS_AUDIO
}

"An episode's pictures, each PNG or JPEG of exactly its size"
enum EpisodeImage {
    "1920 × 1080"
    THUMBNAIL
    "1920 × 1080, with titleB"
    THUMBNAIL_B
    "1920 × 1080, with titleC"
    THUMBNAIL_C
    "1920 × 1080: the thumbnail without its words, for ogrodje.si"
    WEB
    "3000 × 3000"
    COVER
}

"""
Where the browser sends a picture: a resumable upload, started with a POST to url with exactly these headers and no
body, after which the file is PUT to the Location that answers. It only starts until expires.
"""
type ArtworkUpload {
    "What setEpisodeImage takes"
    id: ID!
    url: String!
    headers: [Header!]!
    expires: String!
}

type Header {
    name: String!
    value: String!
}

"One of an episode's pictures, as an upload made it"
type EpisodeImageSet {
    kind: EpisodeImage!
    image: Image!
    "Where it is in the episode's first Dropbox folder; null when the episode has none"
    dropbox: DropboxCopy
}

type DropboxCopy {
    "Where it is in the folder's place; null when it isn't there"
    path: String
    "Whether MetaOS put it there; false when it was there already"
    copied: Boolean!
    "Why it isn't there"
    error: String
}

type Episode {
    id: ID!
    "e.g. S05E08"
    code: String
    title: String!
    "An alternative title, which the title is A/B tested against. Null without a signed-in user."
    titleB: String
    "Another alternative title, as titleB"
    titleC: String
    "The show it's part of"
    show: String
    "Its show's colour, as hex RGB, e.g. #0404a4"
    showColor: String
    status: EpisodeStatus!
    "The recording session it's part of"
    session: Session
    "Who recommended it: by default the person of whoever added it. Null without a signed-in user."
    recommendedBy: Person
    "When it is or was recorded, e.g. 2026-10-19"
    recordingDate: String
    "When it was released, e.g. 2026-10-19"
    airedDate: String
    "Description of the episode, in Markdown"
    summary: String
    "Very short summary of the episode, e.g. a sentence, in Markdown"
    tinySummary: String
    youtubeUrl: String
    spotifyUrl: String
    applePodcastsUrl: String
    "The full episode on Patreon, as video (PATREON)"
    patreonUrl: String
    "The full episode on Patreon, as audio only (PATREON_AUDIO)"
    patreonAudioUrl: String
    "Its bonus on Patreon, as video (PATREON_BONUS)"
    patreonBonusUrl: String
    "Its bonus on Patreon, as audio only (PATREON_BONUS_AUDIO)"
    patreonBonusAudioUrl: String
    """
    The people on the episode, each once with all of their roles; hosts first, candidates last. Candidates only for a
    signed-in user.
    """
    people: [EpisodePerson!]!
    "Google Docs about the episode, e.g. its preparation doc, the first linked first. None without a signed-in user."
    documents: [Document!]!
    "When it was added to MetaOS, e.g. 2026-10-19"
    addedDate: String!
    "AI-generated summary of the episode, in Markdown. Null without a signed-in user."
    machineSummary: String
    "Koofr folders about the episode, e.g. its recordings. None without a signed-in user."
    koofrFolders: [KoofrFolder!]!
    "Dropbox folders about the episode, e.g. its artwork, by path. None without a signed-in user."
    dropboxFolders: [DropboxFolder!]!
    "Every change to the episode, to what's linked to it and to its discussion, oldest first. None without a signed-in user."
    history: [Change!]!
    "Its discussion, oldest first. None without a signed-in user."
    comments: [Comment!]!
    "Its thumbnail, 1920 × 1080"
    thumbnail: Image
    "The thumbnail that goes with titleB, as they're A/B tested together. Null without a signed-in user."
    thumbnailB: Image
    "The thumbnail that goes with titleC, as thumbnailB"
    thumbnailC: Image
    "Its web picture: the thumbnail without its words, for ogrodje.si, 1920 × 1080"
    web: Image
    "Its cover, e.g. for podcast apps, 3000 × 3000"
    cover: Image
}

"""
A picture MetaOS serves to everyone from its public bucket, at https://media.ogrodje.si in production: the original,
and smaller copies of it for lists and pages. What a URL shows never changes, so browsers may keep it for good.
"""
type Image {
    "The file it was made from, e.g. ogrodje-vresGams-thumb1.png"
    name: String!
    "The original"
    url: String!
    width: Int!
    height: Int!
    "Copies of it, 320, 640, 1280 and 1920 px wide where it's wider than that, the narrowest first"
    sizes: [ImageSize!]!
    "The original's SHA-256, in hex: the same file is the same picture"
    sha256: String!
}

type ImageSize {
    width: Int!
    url: String!
}

"A folder in Koofr that's shared with Ogrodje's bot: a place (a shared folder), named when Koofr answers, and a path in it"
type KoofrFolder {
    place: String!
    placeName: String
    path: String!
    "The folder in Koofr's web app, for anyone the place is shared with"
    url: String!
    """
    The photos in the folder by name: those right in it, then those in the folders right in it; all of them, or the
    first limit. None without a signed-in user, or when Koofr doesn't answer.
    """
    photos(limit: Int): [KoofrPhoto!]!
}

"""
A folder in Dropbox, in a place (a folder shared with Ogrodje's bot): where it is now, as it's linked by its Dropbox ID,
which stays with it when it's moved or renamed; where it was linked when Dropbox doesn't answer
"""
type DropboxFolder {
    place: String!
    "Named when Dropbox answers"
    placeName: String
    path: String!
    "Gone from its place: deleted, or moved out of it"
    missing: Boolean!
    """
    A link to the folder that only those with access to it can open, wherever they have it in their Dropbox; or, while
    there's none, its path in Dropbox's web app, for those who have the place where the bot has it
    """
    url: String!
    """
    The pictures in the folder by name, e.g. an episode's artwork: those right in it, then those in the folders right in
    it; all of them, or the first limit. None without a signed-in user, when it's missing, or when Dropbox doesn't answer.
    """
    pictures(limit: Int): [DropboxPicture!]!
}

"A picture in a Dropbox folder: jpg, png, gif, webp, tiff or bmp"
type DropboxPicture {
    name: String!
    path: String!
    "MetaOS's path to a thumbnail, at most 640 × 480; it needs the bearer token, as the rest of the API does"
    thumbnail: String!
    "The linked folder it's in, as the folder's url opens it"
    url: String!
}

"A photo in a Koofr folder"
type KoofrPhoto {
    name: String!
    path: String!
    "MetaOS's path to a thumbnail, 512 px wide; it needs the bearer token, as the rest of the API does"
    thumbnail: String!
    "The folder it's in, in Koofr's web app"
    url: String!
}

"A change from the audit log, told as what happened"
type Change {
    "When, e.g. 2026-10-19T21:30:12.345+02:00"
    at: String!
    "Who made it, when they were signed in: their person's name, or else their username"
    actor: String
    "The OAuth client it came through, e.g. an MCP client's ID"
    client: String
    "The MCP tool that made it"
    tool: String
    "What it's a change to, e.g. the episode itself, or someone's role on it"
    kind: ChangeKind!
    "The comment it's a change to, when it's one to a comment"
    commentId: ID
    "What happened, e.g. Added Jure Čuhalev as host"
    summary: String!
    "The fields that changed, by their names"
    fields: [FieldChange!]!
    "What it's a change to, in recentChanges; null in an episode's or session's own history, which is about it"
    about: ChangeSubject
}

"The episode, session or person a change is to"
type ChangeSubject {
    kind: ChangeKind!
    id: ID!
    "An episode's title, a session's date and name (or else place), a person's name"
    name: String!
    "An episode's code, once it has one"
    code: String
}

"One field of a change. From and to are null when there's nothing short to show, e.g. for a summary."
type FieldChange {
    field: String!
    from: String
    to: String
}

"A Google Doc in Ogrodje's Drive folder"
type Document {
    fileId: ID!
    url: String!
}

"Where and when several episodes get recorded, e.g. at a conference"
type Session {
    id: ID!
    "e.g. 2026-10-22"
    date: String!
    "What it's called, e.g. AWS Community Day Adria 2026. Without one it goes by its location, else by its date."
    name: String
    "Where it is, e.g. the venue"
    location: String
    "Google Docs about the session, e.g. its recording day plan, the first linked first. None without a signed-in user."
    documents: [Document!]!
    "Street address of the location. Null without a signed-in user."
    address: String
    "Its episodes, by code. None without a signed-in user."
    episodes: [Episode!]!
    "Koofr folders about the session, e.g. everything recorded that day. None without a signed-in user."
    koofrFolders: [KoofrFolder!]!
    "Dropbox folders about the session, by path. None without a signed-in user."
    dropboxFolders: [DropboxFolder!]!
    "Every change to the session, to what's linked to it, to which episodes are in it and to its discussion, oldest first. None without a signed-in user."
    history: [Change!]!
    "Its discussion, oldest first. None without a signed-in user."
    comments: [Comment!]!
}

"A comment in an episode's or a recording session's discussion, as on GitHub"
type Comment {
    id: ID!
    "Markdown"
    body: String!
    author: CommentAuthor!
    "When it was written, e.g. 2026-10-19T21:30:12.345+02:00"
    createdAt: String!
    "When its text last changed; null if it never did"
    editedAt: String
    "The MCP tool it was written with, e.g. comment_on_episode; null for MetaOS's own pages"
    tool: String
    "Whether the signed-in user wrote it, and so may edit and delete it"
    mine: Boolean!
}

"Who wrote a comment"
type CommentAuthor {
    "Their person's name, or else their username"
    name: String!
    username: String
    "The person linked to them by verified email when they wrote it; null if there was none, or they've been deleted since"
    person: Person
}

"Where an episode is in its lifecycle"
enum EpisodeStatus {
    IDEA
    PLANNED
    SCHEDULED
    RECORDED
    IN_PRODUCTION
    READY
    EARLY_ACCESS
    PUBLISHED
    ON_HOLD
    CANCELLED
}

type EpisodePerson {
    personId: ID!
    name: String!
    roles: [Role!]!
    "Their picture, as their avatar"
    avatar: Image
}

enum Role {
    HOST
    CO_HOST
    GUEST
    PRODUCER
    CONSULTANT
    DESIGNER
    "Could be the episode's guest, e.g. an idea's, until they're confirmed as one"
    CANDIDATE
}

type CurrentUser {
    username: String
    email: String
    emailVerified: Boolean!
    "The person the user is: their account's, or else the one with their verified email"
    person: Person
    "Their account, once MetaOS has seen it"
    account: Account
    "Whether they may link accounts to people and unlink them, which only one user may"
    canLinkAccounts: Boolean!
}

"""
A Keycloak user MetaOS has seen, which may sign in with several identity providers (Google, Discord, ...), and the
person it is. Its details are as the token said them when they last changed.
"""
type Account {
    id: ID!
    "Keycloak's username, e.g. the email for a Google sign-in"
    username: String
    name: String
    email: String
    emailVerified: Boolean!
    person: Person
    "How it was linked to its person: by its verified email, or by someone"
    linkedHow: AccountLink
    "When, e.g. 2026-10-19T21:30:12.345+02:00"
    linkedAt: String
    "Who linked it, by name; null when its email did"
    linkedBy: String
    "When MetaOS first saw it"
    createdAt: String!
}

"What a change in the history is to"
enum ChangeKind {
    "The episode itself, or an episode moving in or out of the session"
    EPISODE
    "The session itself"
    SESSION
    "Someone added to the episode, removed from it, or given another role on it; or a person themselves"
    PERSON
    "A Google Doc linked or unlinked"
    DOCUMENT
    KOOFR_FOLDER
    DROPBOX_FOLDER
    "A comment written, edited or deleted"
    COMMENT
    "A sign-in linked to a person or unlinked"
    ACCOUNT
    OTHER
}

enum AccountLink {
    EMAIL
    MANUAL
}

"Someone on Ogrodje's episodes, e.g. a host or a guest"
type Person {
    id: ID!
    name: String!
    "A line about who they are, e.g. their role and company"
    bio: String
    "Their own website"
    homepageUrl: String
    linkedinUrl: String
    "On Twitter or X"
    twitterUrl: String
    instagramUrl: String
    facebookUrl: String
    """
    The episodes they're on, each once with all of their roles, the latest first. Anyone not signed in gets only the
    released ones, without candidates.
    """
    episodes: [PersonEpisode!]!
    "The episodes they recommended, the latest first. None without a signed-in user."
    recommended: [Episode!]!
    "Their picture"
    avatar: Image
    "The accounts they sign in with. None without a signed-in user."
    accounts: [Account!]!
}

"An episode a person is on, with their roles in it"
type PersonEpisode {
    episode: Episode!
    roles: [Role!]!
}

"""
What a search found: the episode whose code or ID the text is, alone; a season's episodes; or the best matches of each
kind, and how many there are in all
"""
type SearchResults {
    episode: Episode
    "The season the text names, e.g. 4 for S04, whose episodes the episodes are"
    season: Int
    episodes: [EpisodeHit!]!
    people: [PersonHit!]!
    sessions: [SessionHit!]!
    "How many episodes match, also past the limit"
    episodeCount: Int!
    personCount: Int!
    sessionCount: Int!
}

"An episode a search found"
type EpisodeHit {
    episode: Episode!
    "Where it matched, the best first"
    matchedIn: [SearchField!]!
    """
    The text it matched in when that's an alternative title or a summary, which its row wouldn't show otherwise: the
    title, or the part of the summary around the match, as plain text
    """
    snippet: String
}

"A person a search found"
type PersonHit {
    person: Person!
    matchedIn: [SearchField!]!
}

"A recording session a search found"
type SessionHit {
    session: Session!
    matchedIn: [SearchField!]!
}

"Where a search matched: an episode's code, titles, people, show, summaries or session; a person's name or bio; a session's name, place, address or date"
enum SearchField {
    CODE
    TITLE
    ALTERNATIVE_TITLE
    PEOPLE
    SHOW
    TINY_SUMMARY
    SUMMARY
    SESSION
    NAME
    BIO
    LOCATION
    ADDRESS
    DATE
}
